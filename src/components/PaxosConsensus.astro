---
// Interactive Paxos Consensus Algorithm Visualization
---

<div class="canvas-container">
  <canvas id="paxos-canvas" width="700" height="320"></canvas>
</div>

<style>
.canvas-container {
  display: flex;
  justify-content: center;
  margin: 1.5rem 0;
  background: #111827;
  border-radius: 12px;
  padding: 1rem;
  border: 1px solid #1f2937;
}

canvas {
  max-width: 100%;
  height: auto;
}

.controls {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  margin-top: 0.75rem;
  flex-wrap: wrap;
}

button {
  background: #1f2937;
  color: #e5e7eb;
  border: 1px solid #374151;
  padding: 0.4rem 1rem;
  border-radius: 6px;
  cursor: pointer;
  font-family: inherit;
  font-size: 0.85rem;
  transition: background 0.15s;
}

button:hover {
  background: #374151;
}

button.active {
  background: #60a5fa;
  border-color: #60a5fa;
  color: #0f172a;
}
</style>

<div class="controls">
  <button id="btn-phase1" class="active">Phase 1: Prepare</button>
  <button id="btn-phase2">Phase 2: Accept</button>
  <button id="btn-learned">Learned</button>
  <button id="btn-reset">Reset</button>
</div>

<script>
(function() {
  const canvas = document.getElementById('paxos-canvas');
  const ctx = canvas.getContext('2d');
  const W = 700, H = 320;

  const btnPhase1 = document.getElementById('btn-phase1');
  const btnPhase2 = document.getElementById('btn-phase2');
  const btnLearned = document.getElementById('btn-learned');
  const btnReset = document.getElementById('btn-reset');

  // Nodes
  const proposer = { label: 'Proposer', x: 350, y: 55, color: '#f59e0b', w: 80, h: 32 };
  const acceptors = [
    { label: 'Acceptor 1', x: 120, y: 220, color: '#60a5fa', w: 100, h: 32 },
    { label: 'Acceptor 2', x: 350, y: 220, color: '#60a5fa', w: 100, h: 32 },
    { label: 'Acceptor 3', x: 580, y: 220, color: '#60a5fa', w: 100, h: 32 },
  ];

  let phase = 'phase1'; // phase1 | phase2 | learned
  let tick = 0;
  let animFrame;
  let promiseCount = 0;
  let acceptCount = 0;

  // Phase 1 packets: proposer → each acceptor
  const phase1Packets = [
    { from: proposer, to: acceptors[0], progress: 0, done: false },
    { from: proposer, to: acceptors[1], progress: 0, done: false },
    { from: proposer, to: acceptors[2], progress: 0, done: false },
  ];

  // Phase 1 responses: acceptor → proposer
  const phase1Responses = [
    { from: acceptors[0], to: proposer, progress: 0, done: false },
    { from: acceptors[1], to: proposer, progress: 0, done: false },
    { from: acceptors[2], to: proposer, progress: 0, done: false },
  ];

  // Phase 2 packets: proposer → each acceptor
  const phase2Packets = [
    { from: proposer, to: acceptors[0], progress: 0, done: false },
    { from: proposer, to: acceptors[1], progress: 0, done: false },
    { from: proposer, to: acceptors[2], progress: 0, done: false },
  ];

  // Phase 2 responses
  const phase2Responses = [
    { from: acceptors[0], to: proposer, progress: 0, done: false },
    { from: acceptors[1], to: proposer, progress: 0, done: false },
    { from: acceptors[2], to: proposer, progress: 0, done: false },
  ];

  function reset() {
    phase = 'phase1';
    tick = 0;
    promiseCount = 0;
    acceptCount = 0;
    phase1Packets.forEach(p => { p.progress = 0; p.done = false; });
    phase1Responses.forEach(p => { p.progress = 0; p.done = false; });
    phase2Packets.forEach(p => { p.progress = 0; p.done = false; });
    phase2Responses.forEach(p => { p.progress = 0; p.done = false; });
    acceptors.forEach(a => { a.promised = false; a.accepted = false; a.voted = false; });
    btnPhase1.classList.add('active');
    btnPhase2.classList.remove('active');
    btnLearned.classList.remove('active');
  }

  function setPhase(p) {
    if (p === 'phase2') {
      // Auto-complete phase 1
      phase1Packets.forEach(pkt => { pkt.progress = 1; pkt.done = true; });
      phase1Responses.forEach(pkt => { pkt.progress = 1; pkt.done = true; });
      promiseCount = 3;
      acceptors.forEach(a => { a.promised = true; });
    }
    if (p === 'learned') {
      phase1Packets.forEach(pkt => { pkt.progress = 1; pkt.done = true; });
      phase1Responses.forEach(pkt => { pkt.progress = 1; pkt.done = true; });
      phase2Packets.forEach(pkt => { pkt.progress = 1; pkt.done = true; });
      phase2Responses.forEach(pkt => { pkt.progress = 1; pkt.done = true; });
      promiseCount = 3;
      acceptCount = 3;
      acceptors.forEach(a => { a.promised = true; a.accepted = true; a.voted = true; });
    }
    phase = p;
    btnPhase1.classList.toggle('active', p === 'phase1');
    btnPhase2.classList.toggle('active', p === 'phase2');
    btnLearned.classList.toggle('active', p === 'learned');
  }

  btnPhase1.addEventListener('click', () => setPhase('phase1'));
  btnPhase2.addEventListener('click', () => setPhase('phase2'));
  btnLearned.addEventListener('click', () => setPhase('learned'));
  btnReset.addEventListener('click', () => { reset(); });

  function drawArrow(x1, y1, x2, y2, color, label, dashed) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const len = Math.sqrt(dx*dx + dy*dy);
    const headLen = 10;
    const angle = Math.atan2(dy, dx);

    ctx.save();
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = 1.5;
    if (dashed) ctx.setLineDash([5, 4]);
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2 - headLen * Math.cos(angle), y2 - headLen * Math.sin(angle));
    ctx.stroke();

    // Arrowhead
    ctx.setLineDash([]);
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - headLen * Math.cos(angle - Math.PI/6), y2 - headLen * Math.sin(angle - Math.PI/6));
    ctx.lineTo(x2 - headLen * Math.cos(angle + Math.PI/6), y2 - headLen * Math.sin(angle + Math.PI/6));
    ctx.closePath();
    ctx.fill();
    ctx.restore();

    // Label
    if (label) {
      const mx = (x1 + x2) / 2;
      const my = (y1 + y2) / 2;
      ctx.save();
      ctx.fillStyle = '#9ca3af';
      ctx.font = '11px JetBrains Mono, monospace';
      ctx.textAlign = 'center';
      ctx.fillText(label, mx, my - 5);
      ctx.restore();
    }
  }

  function drawNode(node, idx, isLearner) {
    const radius = 8;
    ctx.save();

    // Shadow
    ctx.shadowColor = node.color + '44';
    ctx.shadowBlur = 8;

    // Box
    ctx.fillStyle = node.color;
    ctx.beginPath();
    ctx.roundRect(node.x - node.w/2, node.y - node.h/2, node.w, node.h, radius);
    ctx.fill();

    ctx.shadowBlur = 0;

    // Text
    ctx.fillStyle = node.label.startsWith('Acceptor') ? '#0f172a' : '#0f172a';
    ctx.font = 'bold 12px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(node.label, node.x, node.y);
    ctx.restore();

    // Status indicator
    if (node.promised) {
      ctx.save();
      ctx.fillStyle = '#fbbf24';
      ctx.font = '10px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('PROMISED', node.x, node.y + node.h/2 + 12);
      ctx.restore();
    }
    if (node.accepted) {
      ctx.save();
      ctx.fillStyle = '#34d399';
      ctx.font = '10px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('ACCEPTED', node.x, node.y + node.h/2 + 24);
      ctx.restore();
    }
    if (node.voted) {
      ctx.save();
      ctx.fillStyle = '#34d399';
      ctx.font = '10px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('✓ LEARNED', node.x, node.y + node.h/2 + 36);
      ctx.restore();
    }
  }

  function drawPacket(pkt, color, label) {
    if (pkt.done) return;
    const x = pkt.from.x + (pkt.to.x - pkt.from.x) * pkt.progress;
    const y = pkt.from.y + (pkt.to.y - pkt.from.y) * pkt.progress;

    ctx.save();
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.arc(x, y, 6, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#0f172a';
    ctx.font = 'bold 9px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(label || 'N', x, y);
    ctx.restore();
  }

  function animate() {
    ctx.clearRect(0, 0, W, H);

    // Background label
    ctx.fillStyle = '#6b7280';
    ctx.font = '13px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(
      phase === 'phase1' ? 'Paxos Phase 1: Proposer sends Prepare(N) to Acceptors' :
      phase === 'phase2' ? 'Paxos Phase 2: Proposer sends Accept(N, V) to Acceptors' :
      'Paxos: Value V is CHOSEN — majority accepted',
      W/2, 18
    );

    if (phase === 'phase1') {
      // Animate outgoing packets
      if (!phase1Packets[0].done) {
        phase1Packets.forEach(p => {
          if (!p.done) p.progress = Math.min(1, p.progress + 0.025);
          if (p.progress >= 1) p.done = true;
        });
      } else {
        // Show promise responses
        phase1Responses.forEach(p => {
          if (!p.done) p.progress = Math.min(1, p.progress + 0.03);
          if (p.progress >= 1) {
            p.done = true;
            promiseCount = 3;
            acceptors.forEach(a => { a.promised = true; });
          }
        });
      }

      // Draw arrows
      phase1Packets.forEach(p => {
        const dashed = !p.done && p.progress < 1;
        drawArrow(p.from.x, p.from.y + 16, p.to.x, p.to.y - 16, '#f59e0b', p.done ? 'Prepare(N)' : null, dashed);
      });
      phase1Responses.forEach(p => {
        const dashed = !p.done && p.progress < 1;
        drawArrow(p.from.x, p.from.y - 16, p.to.x, p.to.y + 16, '#34d399', p.done ? 'Promise' : null, dashed);
      });

      // Draw pending packets
      phase1Packets.forEach(p => drawPacket(p, '#f59e0b', 'N'));
      phase1Responses.forEach(p => drawPacket(p, '#34d399', 'P'));

    } else if (phase === 'phase2') {
      // Phase 1 arrows (faded, done)
      ctx.globalAlpha = 0.35;
      phase1Packets.forEach(p => drawArrow(p.from.x, p.from.y + 16, p.to.x, p.to.y - 16, '#f59e0b', null, false));
      phase1Responses.forEach(p => drawArrow(p.from.x, p.from.y - 16, p.to.x, p.to.y + 16, '#34d399', null, false));
      ctx.globalAlpha = 1;

      // Phase 2 animation
      if (!phase2Packets[0].done) {
        phase2Packets.forEach(p => {
          if (!p.done) p.progress = Math.min(1, p.progress + 0.025);
          if (p.progress >= 1) p.done = true;
        });
      } else {
        phase2Responses.forEach(p => {
          if (!p.done) p.progress = Math.min(1, p.progress + 0.03);
          if (p.progress >= 1) {
            p.done = true;
            acceptCount = 3;
            acceptors.forEach(a => { a.accepted = true; a.voted = true; });
          }
        });
      }

      phase2Packets.forEach(p => {
        const dashed = !p.done && p.progress < 1;
        drawArrow(p.from.x, p.from.y + 16, p.to.x, p.to.y - 16, '#f59e0b', p.done ? 'Accept(N,V)' : null, dashed);
      });
      phase2Responses.forEach(p => {
        const dashed = !p.done && p.progress < 1;
        drawArrow(p.from.x, p.from.y - 16, p.to.x, p.to.y + 16, '#34d399', p.done ? 'Accepted' : null, dashed);
      });

      phase2Packets.forEach(p => drawPacket(p, '#f59e0b', 'V'));
      phase2Responses.forEach(p => drawPacket(p, '#34d399', 'A'));

    } else {
      // Learned: show static complete picture
      phase1Packets.forEach(p => drawArrow(p.from.x, p.from.y + 16, p.to.x, p.to.y - 16, '#f59e0b', 'Prepare(N)', false));
      phase1Responses.forEach(p => drawArrow(p.from.x, p.from.y - 16, p.to.x, p.to.y + 16, '#34d399', 'Promise', false));
      phase2Packets.forEach(p => drawArrow(p.from.x, p.from.y + 16, p.to.x, p.to.y - 16, '#f59e0b', 'Accept(N,V)', false));
      phase2Responses.forEach(p => drawArrow(p.from.x, p.from.y - 16, p.to.x, p.to.y + 16, '#34d399', 'Accepted', false));

      // Highlight chosen value
      ctx.save();
      ctx.fillStyle = '#10b981';
      ctx.font = 'bold 14px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Value V CHOSEN — majority accepted', W/2, H - 12);
      ctx.restore();
    }

    // Draw nodes
    drawNode(proposer, -1);
    acceptors.forEach((a, i) => drawNode(a, i));

    tick++;
    animFrame = requestAnimationFrame(animate);
  }

  reset();
  animate();
})();
</script>
