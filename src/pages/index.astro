---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="systeminternals.dev — Systems programming, Linux internals & networking">
  <h1>systeminternals.dev</h1>
  <p style="color:var(--text-muted);margin-top:-0.5rem;margin-bottom:2rem;">Deep dives on Linux internals, networking protocols, distributed systems, and database performance. Plus an interactive <a href="/defi/">DeFi</a> sandbox.</p>
  <h2 style="margin-top:1rem;">Latest posts</h2>
  <ul class="post-list">
    {posts.map((post) => {
      const formattedDate = post.data.date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      return (
        <li class="post-item">
          <a href={`/posts/${post.slug}`}>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="post-meta">{formattedDate}</span>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>
