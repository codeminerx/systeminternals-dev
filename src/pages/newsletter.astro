---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Newsletter"
  description="Get deep dives on Linux internals, databases, and distributed systems delivered to your inbox."
  ogTitle="Newsletter — System Internals"
  ogDescription="Get deep dives on Linux internals, databases, and distributed systems delivered to your inbox."
>
  <div class="page">
    <header>
      <p class="eyebrow">Stay Sharp</p>
      <h1>Systems Deep Dives,<br />Delivered.</h1>
      <p class="lead">
        Join engineers who get System Internals posts in their inbox.
        Deep technical content on Linux internals, databases, networking, and distributed systems — no noise, no spam.
      </p>
    </header>

    <section class="signup">
      <div class="form-wrapper">
        <form id="newsletter-form" class="newsletter-form">
          <div class="form-row">
            <label for="email" class="sr-only">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="your@email.com"
              required
              autocomplete="email"
              class="email-input"
            />
            <button type="submit" class="subscribe-btn">Subscribe →</button>
          </div>
        </form>
        <p id="form-status" class="form-status" aria-live="polite"></p>
      </div>
      <p class="privacy-note">No spam. Unsubscribe anytime. Your email stays private.</p>
    </section>

    <section>
      <h2>What You'll Get</h2>
      <ul class="perks">
        <li>
          <span class="perk-emoji">📖</span>
          <div>
            <strong>In-depth posts</strong>
            <span>Deep technical articles that go beyond surface-level explanations — the kind you'd bookmark and reference later.</span>
          </div>
        </li>
        <li>
          <span class="perk-emoji">🚀</span>
          <div>
            <strong>Early access</strong>
            <span>New posts go to subscribers before they're shared elsewhere.</span>
          </div>
        </li>
        <li>
          <span class="perk-emoji">💡</span>
          <div>
            <strong>Tools &amp; resources</strong>
            <span>Cheat sheets, reference guides, and write-ups on tools and patterns worth knowing.</span>
          </div>
        </li>
      </ul>
    </section>

    <section class="sample-topics">
      <h2>Topics Covered</h2>
      <div class="topic-tags">
        <span class="topic-tag">Linux internals</span>
        <span class="topic-tag">eBPF &amp; tracing</span>
        <span class="topic-tag">PostgreSQL &amp; MySQL</span>
        <span class="topic-tag">Distributed systems</span>
        <span class="topic-tag">Consensus algorithms</span>
        <span class="topic-tag">TCP/IP internals</span>
        <span class="topic-tag">System design</span>
        <span class="topic-tag">Performance profiling</span>
        <span class="topic-tag">GDB &amp; strace</span>
        <span class="topic-tag">Kubernetes internals</span>
      </div>
    </section>

    <section class="sample">
      <h2>A Sample of What We Cover</h2>
      <ul class="sample-links">
        <li><a href="/posts/strace-debugging-linux-system-calls">strace: Debugging Linux System Calls Like a Pro</a></li>
        <li><a href="/posts/linux-proc-filesystem-deep-dive">Linux /proc Filesystem: A Deep Dive</a></li>
        <li><a href="/posts/dns-deep-dive-how-domain-resolution-works">DNS Deep Dive: How Domain Resolution Works</a></li>
        <li><a href="/posts/raft-consensus-algorithm-deep-dive">Raft Consensus Algorithm: A Deep Dive</a></li>
        <li><a href="/posts/tcp-ip-internals-packet-journey">TCP/IP Internals: How a Packet Travels</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    // Placeholder: wire up to your email provider (Mailchimp, ConvertKit, etc.)
    status.textContent = `Thanks! We'll be in touch at ${email}.`;
    status.className = 'form-status success';
    form.reset();
  });
</script>

<style>
  .page {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-size: 0.8rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .lead {
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  section {
    margin-bottom: 3rem;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text);
  }

  /* Signup form */
  .signup {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 3rem;
  }

  .newsletter-form {
    margin-bottom: 0.75rem;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .email-input {
    flex: 1;
    min-width: 220px;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.95rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.15s;
  }

  .email-input:focus {
    border-color: var(--accent);
  }

  .email-input::placeholder {
    color: var(--text-muted);
  }

  .subscribe-btn {
    padding: 0.65rem 1.25rem;
    background: var(--accent);
    color: #0d0d0d;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: background 0.15s;
    white-space: nowrap;
  }

  .subscribe-btn:hover {
    background: var(--accent-hover);
  }

  .form-status {
    font-size: 0.875rem;
    min-height: 1.25rem;
  }

  .form-status.success {
    color: #4ade80;
  }

  .privacy-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* Perks */
  .perks {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .perks li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .perk-emoji {
    font-size: 1.5rem;
    flex-shrink: 0;
    line-height: 1.4;
  }

  .perks strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .perks span {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Topic tags */
  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .topic-tag {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Sample links */
  .sample-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sample-links li {
    display: flex;
  }

  .sample-links a {
    font-size: 0.95rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s;
  }

  .sample-links a:hover {
    color: var(--accent-hover);
  }

  .sample-links a::before {
    content: '→ ';
    color: var(--text-muted);
  }
</style>